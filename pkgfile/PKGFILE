# Maintainer: Vilmar Catafesta <vcatafesta@gmail.com>

pkgname=voidbr-gnome-shell-extension-dash-to-panel
_uuid=dash-to-panel@jderose9.github.com
_upstream="https://github.com/home-sweet-gnome/dash-to-panel"
pkgdesc="Dash to Panel: barra única (apps + bandeja + relógio) para o GNOME Shell, instalada no sistema"
pkgver=74
pkgrel=2
provides=()  # "eu SOU o $pkgname pkg1, pra quem depender deles"
replaces=()  # "remove o pkg1 pkg2 antigo automaticamente quando eu instalar"
conflicts=() # "nunca me deixe coexistir com o pkg1 pkg2 original"
arch=('any')
license=('GPL-2.0-or-later')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=(
	"git+${_upstream}.git#tag=v${pkgver}"
	"fix-drag-placeholder.patch" # VoidBR: app arrastado para a barra aparece na hora
)
md5sums=('SKIP' 'SKIP')
makedepends=(
	patch
	make
	gettext # msgfmt (traduções .po -> .mo)
	glib    # glib-compile-schemas
)
depends=(
	gnome-shell # 46 a 51 (metadata.json da v74)
)
backup=()

# Automatically detect and use the correct install file
if [ -e "${pkgname}.install" ]; then
	install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
	install=pkgfile.install
fi

prepare() {
	cd "${srcdir}/dash-to-panel"
	# Ao arrastar um app para a barra, o _redisplay() quebrava no marcador de
	# posição do arrasto (DragPlaceholderItem) e o ícone só aparecia depois.
	patch -p1 <"${srcdir}/fix-drag-placeholder.patch"
}

package() {
	cd "${srcdir}/dash-to-panel"

	# Instalação no sistema (DESTDIR definido):
	#   extensão  -> /usr/share/gnome-shell/extensions/${_uuid}
	#   schema    -> /usr/share/glib-2.0/schemas (o gschema override do voidbr-gnome-config só vale aqui)
	#   traduções -> /usr/share/locale
	make install DESTDIR="${pkgdir}" VERSION="${pkgver}"

	# Install license file (upstream)
	install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	# Install documentation (upstream)
	install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	if [ "${update:-}" = "yes" ]; then
		log "Finalizando upgrade"
	else
		log "Finalizando instalação"
	fi

	# Ativa o schema da extensão (e o override do voidbr-gnome-config).
	# Roda também no build da ISO, para o live já subir com a barra.
	log "Compilando schemas do GSettings"
	glib-compile-schemas /usr/share/glib-2.0/schemas || true

	if [ -n "${MKISO_BUILD:-}" ]; then
		echo "${YELLOW}[-]${RESET} Build de ISO detectado (MKISO_BUILD) — pulando."
		return 0
	fi

	if [ -z "${VOIDBR_INSTALLER:-}" ]; then
		:
	fi

}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	post_install
}

post_remove() {
	glib-compile-schemas /usr/share/glib-2.0/schemas || true
}
